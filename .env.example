# OpenAI-compatible relay address
API_URL=https://api.openai.com/v1

# Your API key from relay provider or OpenAI
API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Model name, e.g. claude-3-5-sonnet, gpt-4o
MODEL_NAME=gpt-4o

# Optional: route Dear chat replies through an external Web API service
CHAT_API_BASE_URL=http://127.0.0.1:8000

# Optional: fixed role when using CHAT_API_BASE_URL, e.g. atri/girlfriend/teacher
CHAT_API_ROLE=

# Local service port on VPS
PORT=8080

# Optional bind host
HOST=0.0.0.0

# Login session ttl in hours (default 168)
SESSION_TTL_HOURS=168

# Admin account managed by environment variables
ADMIN_USERNAME=dear_admin
ADMIN_PASSWORD=change_me_now

# Optional admin session ttl in hours (default 12)
ADMIN_SESSION_TTL_HOURS=12

# Set true when using HTTPS reverse proxy
COOKIE_SECURE=false
